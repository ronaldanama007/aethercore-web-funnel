# ==========================================================================
# AetherCore Web Funnel & Scorecard - Environment Configuration
# Copy this file to .env.local and add your Supabase credentials.
# (Note: If left empty, the application runs in self-contained mock mode)
# ==========================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Client Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (for administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL for canonical links and OpenGraph previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
